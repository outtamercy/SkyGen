/*
 * Skyrim Sunrise Theme for SkyGen Plugin
 * Inspired by "Sun barely coming up on the sea of ghosts.png"
 * Colors:
 * Backgrounds: Dark Grey/Navy (#1A1A2E, #28283D)
 * Accents/Highlights: Deep Orange (#FF8C00), Gold (#FFD700)
 * Text: Light Grey (#E0E0E0), Gold for active elements
 * Borders/Separators: Darker Orange/Brown (#8B4513)
 * Gloss pass: gold went metallic — buttons are stamped metal with a
 * light-sweep hover, scrollbars and progress got the chrome treatment.
 * The sea-of-ghosts backdrop is untouched.
 */

QDialog { /* background image: QSS sits in 'themes/', png in 'themes/Skyrim Sunrise/' */
    background-image: url(./Skyrim Sunrise/Sun barely coming up on the sea of ghosts.png);
    background-position: center;
    background-repeat: no-repeat;
    color: #FFD700;
    font-family: "Inter", sans-serif;
    font-size: 10pt;
}

QWidget {
    background-color: transparent;
    color: #FFD700;
    font-family: "Inter", sans-serif;
    font-size: 10pt;
}

/* Make inner content areas transparent to show background through */
QGroupBox, QTabWidget::pane, QPlainTextEdit {
    background-color: transparent;
    border: 1px solid #8B4513;
    border-radius: 8px;
    margin-top: 1.5ex;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 3px;
    background-color: transparent;
    border-radius: 4px;
    color: #FFD700;
}

/* Buttons — burnt-orange metal, sweep on hover */
QPushButton {
    color: #1A1206;
    font-weight: bold;
    border-radius: 8px;
    padding: 8px 15px;
    min-width: 80px;
    min-height: 25px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #E8820C,
        stop:0.4 #CC5A00,
        stop:0.5 #F6A83C,
        stop:0.6 #CC5A00,
        stop:1 #8B3A00);
    border-top: 1px solid #F6A83C;
    border-left: 1px solid #E8820C;
    border-right: 1px solid #7A3200;
    border-bottom: 2px solid #5C2500;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #CC5A00,
        stop:0.7 #E8820C,
        stop:0.8 #FFFFFF,
        stop:0.9 #E8820C,
        stop:1 #8B3A00);
    border-top: 1px solid #FFFFFF;
}
QPushButton:pressed {
    background: #B34700;
    border: 1px solid #F6A83C;
    padding-top: 10px;
    padding-bottom: 6px;
}
QPushButton:disabled {
    background: #555566;
    color: #AAAAAA;
    border: 1px solid #666677;
}

/* Line Edits (Text Inputs) */
QLineEdit {
    background-color: transparent;
    border: 1px solid #8B4513;
    border-radius: 5px;
    padding: 5px;
    color: #FFD700;
}
QLineEdit:focus {
    border: 1px solid #FFD700;
}

/* Combo Boxes (Dropdowns) */
QComboBox {
    background-color: transparent;
    border: 1px solid #8B4513;
    border-radius: 5px;
    padding: 5px;
    color: #FFD700;
    min-height: 25px;
}
QComboBox::drop-down {
    border: 0px;
}
QComboBox::down-arrow {
    image: url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxNiIgaGVpZ2h0PSIxNiIgdmlld0JveD0iMCAwIDE2IDE2Ij48cGF0aCBmaWxsPSIjRjBGMEYwIiBkPSJNMCA0aDE2TDUgMTJIMSA0eiIvPjwvc3ZnPg==);
    width: 10px;
    height: 10px;
}
QComboBox QAbstractItemView {
    background-color: #28283D;
    selection-background-color: #FF8C00;
    color: #FFD700;
    border: 1px solid #8B4513;
    border-radius: 5px;
}

/* Checkboxes */
QCheckBox {
    color: #FFD700;
    spacing: 5px;
    background: transparent;
}
QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #FFD700;
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3F3F57,
        stop:1 #28283D);
}
QCheckBox::indicator:hover { border: 1px solid #FFF3B0; }
QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFB84D,
        stop:1 #CD6600);
    image: url(data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAcAAAAHCAYAAADpN/U5AAAABHNCSVQICAgIfAhkiAAAAAlwSFlzAAALEgAACxIB4eC/fgAAABx0RVh0U29mdHdhcmUATWFjcm9tZWRpYSBGaXJld29ya3sgTWEyqHyrAAAAEklEQVQImWNgGAXDCmSAwQEAEwQBB5kLpLwAAAAASUVORK5CYII=);
}

/* Radio Buttons */
QRadioButton {
    color: #FFD700;
    spacing: 5px;
    background: transparent;
}
QRadioButton::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #FFD700;
    border-radius: 7px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3F3F57,
        stop:1 #28283D);
}
QRadioButton::indicator:hover { border: 1px solid #FFF3B0; }
QRadioButton::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFB84D,
        stop:1 #CD6600);
    border: 1px solid #FFD700;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #8B4513;
    border-top: 0px;
    background-color: transparent;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
QTabBar::tab {
    background-color: transparent;
    color: #FFD700;
    padding: 8px 15px;
    border: 1px solid #8B4513;
    border-bottom: 0px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #4A3A10,
        stop:1 #2E2410);
    color: #FFD700;
    border-color: #FFD700;
    border-bottom: 1px solid transparent;
    font-weight: bold;
}
QTabBar::tab:hover:!selected {
    background-color: #3F3F57;
}

/* Plain Text Edit (Log Display) */
QPlainTextEdit {
    background-color: transparent;
    border: 1px solid #8B4513;
    border-radius: 8px;
    padding: 5px;
    color: #FFD700;
    selection-background-color: #FF8C00;
}

/* Scroll Bars — orange chrome */
QScrollBar:vertical, QScrollBar:horizontal {
    border: 1px solid #3F3F57;
    background: #1A1A2E;
    width: 12px;
    height: 12px;
    margin: 0px;
    border-radius: 6px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFB84D,
        stop:0.5 #FF8C00,
        stop:1 #B35A00);
    border: 1px solid #8B4513;
    border-radius: 5px;
    min-height: 20px;
    min-width: 20px;
}
QScrollBar::handle:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFD580,
        stop:0.5 #FFA500,
        stop:1 #CD6600);
    border: 1px solid #FFD700;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* Progress Bar — molten sweep */
QProgressBar {
    border: 1px solid #8B4513;
    border-radius: 6px;
    text-align: center;
    color: #FFD700;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #28283D,
        stop:1 #1A1A2E);
    height: 14px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0.5, x2:1, y2:0.5,
        stop:0 #B35A00,
        stop:0.5 #FFD580,
        stop:1 #B35A00);
    border-radius: 5px;
}

/* Labels */
QLabel {
    color: #FFD700;
    background: transparent;
}

/* Status Log specific labels */
#conciseStatusLabel {
    color: lightgreen;
    font-weight: bold;
}

/* Tooltips */
QToolTip {
    background: #3F3F57;
    color: #FFD700;
    border: 1px solid #8B4513;
    border-radius: 5px;
    padding: 5px;
    opacity: 200;
}

/* Spin Box (if used) */
QSpinBox, QDoubleSpinBox {
    background-color: transparent;
    border: 1px solid #8B4513;
    border-radius: 5px;
    padding: 5px;
    color: #FFD700;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    border-left: 1px solid #8B4513;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFB84D,
        stop:1 #B35A00);
    border-top-right-radius: 4px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    border-left: 1px solid #8B4513;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFB84D,
        stop:1 #B35A00);
    border-bottom-right-radius: 4px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: #FFA500;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxNiIgaGVpZ2h0PSIxNiIgdmlld0JveD0iMCAwIDE2IDE2Ij48cGF0aCBmaWxsPSIjRjBGMEYwIiBkPSJNOS43OTMgMTFsLTMuNDctMy40N0wxIDExSDl6IiB0cmFuc2Zvcm09InJvdGF0ZSgxODAgOC4zOTY1IDYuOTc1KSIvPjwvc3ZnPg==);
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxNiIgaGVpZ2h0PSIxNiIgdmlld0JveD0iMCAwIDE2IDE2Ij48cGF0aCBmaWxsPSIjRjBGMEYwIiBkPSJNMCA0aDE2TDUgMTJIMSA0eiIvPjwvc3ZnPg==);
}

/* Splitters */
QSplitter::handle {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3F3F57,
        stop:1 #28283D);
}
QSplitter::handle:hover { background: #FF8C00; }
